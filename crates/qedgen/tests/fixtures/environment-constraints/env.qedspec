spec EnvSingle

type Pool
  | Uninitialized
  | Active of {
      total : U64,
      rate  : U64,
    }

handler init_pool : Pool.Uninitialized -> Pool.Active {
  takes rate_in : U64
  requires rate_in > 0 else Err
  effect {
    rate := rate_in,
    total := 0,
  }
}

handler deposit : Pool.Active -> Pool.Active {
  takes amount : U64
  requires amount > 0 else Err
  effect { total += amount }
}

property rate_floor :
  state.rate > 0 or state.total == 0
  preserved_by all

environment rate_change {
  mutates rate : U64
  constraint rate > 0
}

environment oracle_step {
  external oracle.price : U64
  mutates rate : U64
  constraint rate == oracle.price
  constraint oracle.price >= old(oracle.price)
}
