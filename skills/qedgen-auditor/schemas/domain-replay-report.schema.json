{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qedgen.dev/schemas/auditor/domain-replay-report-v1.schema.json",
  "title": "QEDGen Auditor Domain Replay Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_uri", "resolved_document_sha256", "account_binding_overlay_sha256", "harness_sha256", "records"],
  "properties": {
    "schema_version": { "const": 1 },
    "schema_uri": { "const": "https://qedgen.dev/schemas/auditor/domain-replay-report-v1.schema.json" },
    "resolved_document_sha256": { "$ref": "#/$defs/sha256" },
    "account_binding_overlay_sha256": { "$ref": "#/$defs/sha256" },
    "harness_sha256": { "$ref": "#/$defs/sha256" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "seed_path", "seed_sha256", "action_count", "command", "status", "exit_code", "error"],
      "properties": {
        "plan_id": { "type": "string", "minLength": 1 },
        "seed_path": { "type": "string", "minLength": 1 },
        "seed_sha256": { "$ref": "#/$defs/sha256" },
        "action_count": { "type": "integer", "minimum": 1 },
        "command": { "type": "array", "minItems": 8, "items": { "type": "string", "minLength": 1 } },
        "status": { "enum": ["completed_zero_exit", "completed_nonzero_exit", "terminated_by_signal", "spawn_failed"] },
        "exit_code": { "type": ["integer", "null"] },
        "error": { "type": ["string", "null"] }
      }
    }
  }
}
