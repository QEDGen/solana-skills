{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qedgen.dev/schemas/auditor/spec-handoff-v1.schema.json",
  "title": "QEDGen Auditor Specification Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_uri", "spec_path", "layers", "language_gaps"],
  "properties": {
    "schema_version": { "const": 1 },
    "schema_uri": { "const": "https://qedgen.dev/schemas/auditor/spec-handoff-v1.schema.json" },
    "spec_path": { "type": "string", "minLength": 1 },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structural", "domain", "regression"],
      "properties": {
        "structural": { "type": "array", "items": { "$ref": "#/$defs/clause" } },
        "domain": { "type": "array", "items": { "$ref": "#/$defs/clause" } },
        "regression": { "type": "array", "items": { "$ref": "#/$defs/clause" } }
      }
    },
    "language_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "reason", "disposition", "current_language_support"],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "disposition": { "const": "document_or_extend_language" },
          "current_language_support": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "disposition", "verification_lanes"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["emitted", "needs_authoring", "language_gap", "excluded"] },
        "spec_path": { "type": "string", "minLength": 1 },
        "authoring": {
          "type": "object",
          "additionalProperties": false,
          "required": ["constructs", "template", "notes"],
          "properties": {
            "constructs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "template": { "type": "string", "minLength": 1 },
            "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "verification_lanes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["check", "manual", "mollusk", "miri", "crucible", "kani", "lean"] }
        }
      }
    }
  }
}
